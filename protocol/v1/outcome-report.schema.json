    "monetaryOutcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "REFUND",
                  "CREDIT",
                  "FEE",
                  "CHARGE",
                  "OTHER"
                ]
              },
              "amountCents": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "amountCents"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
