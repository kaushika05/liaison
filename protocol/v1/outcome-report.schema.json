    "summary",
    "representativeName",
    "department",
    "caseNumber",
    "resolution",
    "monetaryOutcomes",
    "companyCommitments",
    "userActions",
    "deadlines",
    "unresolvedItems",
    "endedAt",
    "durationSeconds",
    "estimatedTelephonyCostUsd"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "turnId": {
          "type": "string"
        },
        "exactQuote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "turnId",
        "exactQuote"
      ],
      "additionalProperties": false
    }
  },
  "$id": "https://liaison-protocol.invalid/v1/outcome-report.schema.json",
  "title": "OutcomeReport"
