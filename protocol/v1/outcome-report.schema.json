{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "RESOLVED",
        "PARTIAL",
        "UNRESOLVED",
        "REFUSED_AUTOMATION",
        "AUTHENTICATION_REQUIRED",
        "DISCONNECTED",
        "TECHNICAL_FAILURE"
      ]
    },
    "summary": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "evidence": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "value",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "representativeName": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "evidence": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "value",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "department": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "evidence": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "value",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "caseNumber": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "evidence": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "value",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "resolution": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "evidence": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "value",
            "evidence"
          ],
          "additionalProperties": false
