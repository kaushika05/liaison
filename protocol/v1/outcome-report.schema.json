    },
    "unresolvedItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "required": [
          "value",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "endedAt": {
      "type": "string"
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "estimatedTelephonyCostUsd": {
      "type": "number",
      "minimum": 0
    },
    "llmUsage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "inputTokens",
        "outputTokens",
        "totalTokens"
      ],
      "additionalProperties": false
    }
