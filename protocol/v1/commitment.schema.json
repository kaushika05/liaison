{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "id": {
      "$ref": "#/$defs/__schema1"
    },
    "party": {
      "$ref": "#/$defs/__schema2"
    },
    "status": {
      "$ref": "#/$defs/__schema3"
    },
    "description": {
      "$ref": "#/$defs/__schema4"
    },
    "amountCents": {
      "$ref": "#/$defs/__schema5"
    },
    "deadline": {
      "$ref": "#/$defs/__schema6"
    },
    "recurring": {
      "$ref": "#/$defs/__schema7"
    },
    "evidence": {
      "$ref": "#/$defs/__schema8"
    },
    "createdAt": {
      "$ref": "#/$defs/__schema10"
    }
  },
  "required": [
    "protocolVersion",
    "id",
    "party",
    "status",
    "description",
    "evidence",
    "createdAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "default": 1,
      "type": "number",
      "const": 1,
      "description": "Liaison Universal Support Protocol major version."
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "COMPANY",
        "USER",
        "AGENT",
        "UNKNOWN"
      ]
    },
    "__schema3": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "CONFIRMED",
        "REJECTED",
        "SUPERSEDED",
        "UNVERIFIED"
      ]
    },
    "__schema4": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "__schema5": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema6": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "__schema7": {
      "type": "boolean"
    },
    "__schema8": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema9"
      }
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "turnId": {
          "type": "string"
        },
        "exactQuote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "turnId",
        "exactQuote"
      ],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "$id": "https://liaison-protocol.invalid/v1/commitment.schema.json",
  "title": "Commitment"
}
