# Liaison is self-hosted. Safe defaults use the browser messaging simulator,
# deterministic mock models, and simulated calls without external credentials.

# Application
APP_NAME=Liaison
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_WSS_URL=ws://localhost:3000
DATABASE_PATH=./data/liaison.db

# Single principal
INSTANCE_MODE=personal
OWNER_DISPLAY_NAME=
OWNER_PHONE_E164=

# Authentication (generate these with `npm run setup`)
APP_ACCESS_KEY=
SESSION_SECRET=
CALL_TOKEN_SECRET=
ACTION_LINK_SECRET=

# Model provider; mock mode is deterministic and free
LLM_MODE=mock
OPENAI_API_KEY=
# Empty uses the official OpenAI endpoint. Custom compatible endpoints are advanced and may not support required structured output.
OPENAI_BASE_URL=
PLANNER_MODEL=gpt-5.6-luna
CONTROLLER_MODEL=gpt-5.6-luna
OUTCOME_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=12000

# Messaging; real SMS is disabled until both mode and allow flag are set
MESSAGING_MODE=web
ALLOW_REAL_MESSAGING=false
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM_NUMBER=
# Operator attestation only: set true after confirming sender/A2P registration in Twilio.
MESSAGING_REGISTRATION_CONFIRMED=false
SMS_UPDATE_DETAIL=STANDARD
SMS_DECISION_TIMEOUT_SECONDS=90
MAX_USER_WAIT_SECONDS=180
SMS_MAX_SEGMENTS_PER_MESSAGE=3
# Operator-entered planning rate. Multiplied by submitted segments to show estimated SMS spend.
ESTIMATED_SMS_COST_PER_SEGMENT_USD=0

# Voice; real telephone calls are disabled until both mode and allow flag are set
TELEPHONY_MODE=simulator
ALLOW_REAL_CALLS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_FROM_NUMBER=
# Backward-compatible alias for deployments created before v2; prefer TWILIO_VOICE_FROM_NUMBER.
TWILIO_FROM_NUMBER=
MAX_CALL_DURATION_MINUTES=30
MAX_CALLS_PER_DAY=5
ALLOWED_DESTINATION_PREFIXES=+1
ESTIMATED_TELEPHONY_COST_PER_MINUTE_USD=0.084

# Security and retention
SECURE_ACTION_LINK_TTL_MINUTES=10
DATA_RETENTION_DAYS=30
TRUST_PROXY=false
LOG_LEVEL=info
