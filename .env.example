# Safe local defaults: simulator + deterministic mock planning need no external credentials.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_WSS_URL=ws://localhost:3000

DATABASE_PATH=./data/liaison.db

# Optional in development (an explicit local bypass appears). Required in production.
APP_ACCESS_KEY=
SESSION_SECRET=
CALL_TOKEN_SECRET=

LLM_MODE=mock
OPENAI_API_KEY=
PLANNER_MODEL=gpt-5.6-luna
CONTROLLER_MODEL=gpt-5.6-luna
OUTCOME_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=12000

TELEPHONY_MODE=simulator
ALLOW_REAL_CALLS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

MAX_CALL_DURATION_MINUTES=30
MAX_CALLS_PER_DAY=5
MAX_CONCURRENT_CALLS=1
ALLOWED_DESTINATION_PREFIXES=+1
ESTIMATED_TELEPHONY_COST_PER_MINUTE_USD=0.084

DATA_RETENTION_DAYS=30
LOG_LEVEL=info
TRUST_PROXY=false
